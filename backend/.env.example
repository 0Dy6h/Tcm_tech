APP_NAME="Qiyan Nexus API"
ENVIRONMENT="dev"
# A2 minimum access control. Empty = open mode (dev default).
# Comma-separated allowlist matched against the X-Access-Token request header.
# Example: QIYAN_ACCESS_TOKENS="dev-token-1,internal-reviewer-2"
QIYAN_ACCESS_TOKENS=""

# Optional LLM provider selection. Default deterministic mode makes no external calls.
# Set QIYAN_LLM_PROVIDER="opencode_go" for the preferred live provider smoke path.
# The "opencode_go" provider uses any OpenAI-compatible chat completions endpoint.
# Current default: ai.router.team gateway with gpt-5.5 model.
# Use QIYAN_LLM_PROVIDER="anthropic" only for later optional Anthropic smoke.
QIYAN_LLM_PROVIDER="deterministic"
# ANTHROPIC_API_KEY is unprefixed on purpose — the anthropic SDK reads this name natively.
ANTHROPIC_API_KEY=""
QIYAN_OPENCODE_GO_API_KEY=""
QIYAN_OPENCODE_GO_BASE_URL="https://ai.router.team/v1"
QIYAN_OPENCODE_GO_MODEL="gpt-5.5"
# gpt-5.5 via router.team does not use thinking tokens — 4096 is adequate.
# Previous deepseek-v4-flash needed >=4000 due to thinking-mode token consumption.
QIYAN_OPENCODE_GO_MAX_TOKENS="4096"
QIYAN_OPENCODE_GO_TEMPERATURE="0.2"
# Cost SLI: USD price per million tokens. Default 0.0 means "do not estimate cost"
# (estimated_cost_usd stays null) so a guessed price is never surfaced.
# Configure once you know the router.team contract pricing.
QIYAN_OPENCODE_GO_PRICE_INPUT_PER_MTOK="0.0"
QIYAN_OPENCODE_GO_PRICE_OUTPUT_PER_MTOK="0.0"

# Semantic grounding gate: minimum claim↔cited-chunk cosine for external providers.
# Applies only to anthropic / opencode_go answers (deterministic/mock skip grounding).
# IMPORTANT: Threshold must match the embedding backend:
#   - hashing backend (default): use 0.40 (lexical overlap proxy, conservative)
#   - bge backend: use 0.78 (true semantic embeddings, validated 2026-05-31)
# Set "0" (or any <=0) to disable semantic grounding.
# See docs/evaluations/2026-05-31-bge-semantic-evaluation.md for validation details.
QIYAN_GROUNDING_SEMANTIC_THRESHOLD="0.40"

# NLI entailment second-stage grounding gate (opt-in, default OFF).
# Cosine similarity (above) measures topical relatedness and cannot tell a
# faithful paraphrase from an on-topic fabrication (both score high). An NLI
# model scores entailment (does the cited chunk entail the claim?), which does
# separate them: on the 2026-06-01 recalibration fixture, faithful claims score
# ~0.99 entailment and on-topic hard negatives score <=0.001, with 0 false
# accepts at any threshold (cosine had 7/7 false accepts). See
# docs/evaluations/2026-06-01-nli-grounding-spike.md.
# Runs only for external providers (anthropic / opencode_go), after the cosine
# pre-filter. Leave QIYAN_NLI_BACKEND empty (or set THRESHOLD<=0) to disable.
#   - QIYAN_NLI_BACKEND="transformers" enables it (lazy-loads ~560 MB mDeBERTa).
#   - QIYAN_NLI_THRESHOLD: minimum entailment to pass; 0.5 is a safe default.
# CI and the default offline path never import transformers or download weights.
QIYAN_NLI_BACKEND=""
QIYAN_NLI_MODEL="MoritzLaurer/mDeBERTa-v3-base-mnli-xnli"
QIYAN_NLI_THRESHOLD="0.0"

# Runtime state backend. Selects how literature / chunk / network task state
# is persisted between calls. JSON and SQLite bootstrap from the same JSON seed
# files under backend/data/, and the full pytest suite passes under either.
#   - "json"       (default): InMemory repositories backed by backend/data/runtime/*.json
#   - "sqlite":               SQLite repositories backed by a single .sqlite3 file
# Path override for the SQLite database (only read when backend="sqlite").
# Default: backend/data/runtime/qiyan_state.sqlite3 (gitignored under runtime/).
QIYAN_STATE_BACKEND="json"
QIYAN_SQLITE_DB_PATH=""

# Network pharmacology data provider. Default "mock" is fully offline and uses
# backend/data/network seed fixtures. Set "live" only for explicit internal
# smoke/reviewer runs that accept external database requests and runtime cache.
# Clearing this variable or setting it back to "mock" is the rollback path.
QIYAN_NETWORK_DATA_PROVIDER="mock"
# Task runner. "local" executes in the current backend process. "celery" is a
# reserved production opt-in and should only be enabled with the future Redis /
# Celery deployment wiring.
QIYAN_NETWORK_TASK_RUNNER="local"
# TCMSP has no default production API contract in this repo. Scraping is blocked
# unless the operator explicitly enables it and accepts stability/usage risk.
QIYAN_NETWORK_ALLOW_TCMSP_SCRAPE="false"
# Optional SwissTargetPrediction-style local artifact import. The backend does
# not crawl SwissTargetPrediction automatically. Supported fields:
# compound,target_symbol,score,source,source_record_id,retrieved_at
QIYAN_NETWORK_TARGET_PREDICTION_FILE=""
# Runtime-only cache for PubChem / ChEMBL / UniProt / STRING / KEGG / TCMSP
# responses. Do not commit its contents.
QIYAN_NETWORK_CACHE_DIR="backend/data/runtime/network_cache"
# Offline Open Targets raw-artifact verification. The manifest is operator-controlled,
# read-only JSON keyed by raw-byte SHA-256; the browser cannot supply artifact hashes.
NETWORK_OPEN_TARGETS_MANIFEST_PATH=""
# Offline ChEMBL raw-artifact verification. This is a separate operator-controlled,
# read-only JSON manifest keyed by raw-byte SHA-256; the browser cannot supply hashes or facts.
NETWORK_CHEMBL_MANIFEST_PATH=""
NETWORK_RAW_ARTIFACT_DIR="backend/data/runtime/network_raw_artifacts"
QIYAN_NETWORK_HTTP_TIMEOUT_SECONDS="15"
QIYAN_NETWORK_RATE_LIMIT_PER_SECOND="1"
